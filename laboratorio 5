using Unity.VisualScripting;
using UnityEngine;
//ejercicios del 1 al 15
//5
public class uno : MonoBehaviour
{
    public bool nieve;
    public bool lluvia;
    public bool nublado;
    public bool soleado;
    public float temperatura;
    // Start is called once before the first execution of Update after the MonoBehaviour is created
    void Start()
    { 
        if (nieve = temperatura >= -10 && temperatura <= 0)
        { 
          Debug.Log("Esta nevando!!");
        }
        if (lluvia = temperatura > 0 && temperatura < 15)
        { 
          Debug.Log("Esta lloviendo");
        }
        if (nublado = temperatura >= 15 && temperatura <= 20) 
        { 
          Debug.Log("Esta nublado"); 
        }
        if (soleado = temperatura > 20)
        {
          Debug.Log("Esta soleado");
        }
   
    }
      

    // Update is called once per frame
    void Update()
    {
        
    }
}
